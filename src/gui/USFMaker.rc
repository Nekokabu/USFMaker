// USF Maker - resources.
// All visible text is set from code (see strings in main.cpp) so that this
// file stays plain ASCII and builds the same with rc.exe and windres.
#include <windows.h>
#include "resource.h"
#include "../engine/version.h"

IDI_APP ICON "USFMaker.ico"

// Application manifest (common controls 6, DPI awareness).  It is embedded
// here for every build system; the Visual Studio project therefore has
// "Generate Manifest" switched off.
1 24 "USFMaker.manifest"

IDD_SETTINGS DIALOGEX 0, 0, 270, 340
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Settings"
FONT 9, "Segoe UI", 0, 0, 0x1
BEGIN
    GROUPBOX        "Emulation", IDC_SET_GROUP_EMU, 7, 7, 256, 90
    AUTOCHECKBOX    "Expansion Pak (8 MB)", IDC_SET_EXPANSION, 15, 20, 240, 10
    LTEXT           "Idle seconds", IDC_SET_IDLE_LABEL, 15, 37, 170, 8
    EDITTEXT        IDC_SET_IDLE, 195, 35, 50, 12, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT           "Threads", IDC_SET_THREADS_LABEL, 15, 52, 170, 8
    EDITTEXT        IDC_SET_THREADS, 195, 50, 50, 12, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT           "Seed", IDC_SET_SEED_LABEL, 15, 67, 170, 8
    EDITTEXT        IDC_SET_SEED, 195, 65, 50, 12, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT           "Hardware", IDC_SET_HW_LABEL, 15, 82, 120, 8
    COMBOBOX        IDC_SET_HW, 145, 80, 100, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    GROUPBOX        "Aleck64 DIP switches", IDC_SET_GROUP_DIP, 7, 102, 256, 66
    LTEXT           "SW1", IDC_SET_SW1_LABEL, 15, 117, 22, 8
    AUTOCHECKBOX    "1", IDC_SET_DIP0, 40, 116, 24, 10
    AUTOCHECKBOX    "2", IDC_SET_DIP1, 66, 116, 24, 10
    AUTOCHECKBOX    "3", IDC_SET_DIP2, 92, 116, 24, 10
    AUTOCHECKBOX    "4", IDC_SET_DIP3, 118, 116, 24, 10
    AUTOCHECKBOX    "5", IDC_SET_DIP4, 144, 116, 24, 10
    AUTOCHECKBOX    "6", IDC_SET_DIP5, 170, 116, 24, 10
    AUTOCHECKBOX    "7", IDC_SET_DIP6, 196, 116, 24, 10
    AUTOCHECKBOX    "8", IDC_SET_DIP7, 222, 116, 24, 10
    LTEXT           "SW2", IDC_SET_SW2_LABEL, 15, 132, 22, 8
    AUTOCHECKBOX    "1", IDC_SET_DIP8, 40, 131, 24, 10
    AUTOCHECKBOX    "2", IDC_SET_DIP9, 66, 131, 24, 10
    AUTOCHECKBOX    "3", IDC_SET_DIP10, 92, 131, 24, 10
    AUTOCHECKBOX    "4", IDC_SET_DIP11, 118, 131, 24, 10
    AUTOCHECKBOX    "5", IDC_SET_DIP12, 144, 131, 24, 10
    AUTOCHECKBOX    "6", IDC_SET_DIP13, 170, 131, 24, 10
    AUTOCHECKBOX    "7", IDC_SET_DIP14, 196, 131, 24, 10
    AUTOCHECKBOX    "8", IDC_SET_DIP15, 222, 131, 24, 10
    AUTOCHECKBOX    "Test menu", IDC_SET_A64_TESTMENU, 15, 146, 240, 10

    GROUPBOX        "Songs", IDC_SET_GROUP_SONG, 7, 174, 256, 90
    LTEXT           "Loops", IDC_SET_LOOPS_LABEL, 15, 189, 170, 8
    EDITTEXT        IDC_SET_LOOPS, 195, 187, 50, 12, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT           "Fade", IDC_SET_FADE_LABEL, 15, 205, 170, 8
    EDITTEXT        IDC_SET_FADE, 195, 203, 50, 12, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT           "Default length", IDC_SET_DEFLEN_LABEL, 15, 221, 170, 8
    EDITTEXT        IDC_SET_DEFLEN, 195, 219, 50, 12, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT           "Max analysis", IDC_SET_MAXLEN_LABEL, 15, 237, 170, 16
    EDITTEXT        IDC_SET_MAXLEN, 195, 235, 50, 12, ES_NUMBER | ES_AUTOHSCROLL

    GROUPBOX        "Output", IDC_SET_GROUP_OUT, 7, 269, 256, 40
    AUTOCHECKBOX    "Full ROM", IDC_SET_FULLROM, 15, 282, 240, 20, BS_MULTILINE | BS_TOP

    DEFPUSHBUTTON   "OK", IDOK, 153, 318, 52, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 211, 318, 52, 14
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION USFM_VERSION_MAJOR,USFM_VERSION_MINOR,USFM_VERSION_PATCH,0
PRODUCTVERSION USFM_VERSION_MAJOR,USFM_VERSION_MINOR,USFM_VERSION_PATCH,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "USF Maker"
            VALUE "FileVersion", USFM_VERSION_STRING4
            VALUE "InternalName", "USFMaker"
            VALUE "LegalCopyright", "GPL-2.0-or-later"
            VALUE "OriginalFilename", "USFMaker.exe"
            VALUE "ProductName", "USF Maker"
            VALUE "ProductVersion", USFM_VERSION_STRING4
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
